#include "brew/filters/intent_estimator.hpp"
// Static prelude for the auto-generated brewpy module: the `latest` helper used by every RFS
// tracker, plus brewpy_static_extra() which hand-binds fusion and template-matching helpers.
#include "brew/utils/fusion/ggiw_gci.hpp"
#include "brew/utils/fusion/usggiw_gci.hpp"
#include "brew/utils/fusion/iggiw_gci.hpp"
#include "brew/models/trajectory_ggiw.hpp"
#include "brew/models/merge/trajectory_ggiw.hpp"
#include "brew/filters/trajectory_ggiw_ekf.hpp"
#include "brew/multiObjectTrackers/phd.hpp"
#include "brew/models/trajectory_usggiw.hpp"
#include "brew/models/merge/trajectory_usggiw.hpp"
#include "brew/filters/trajectory_usggiw_ekf.hpp"
#include "brew/multiObjectTrackers/phd.hpp"
#include "brew/utils/registration/icp_base.hpp"
#include "brew/utils/registration/pca_icp.hpp"
#include "brew/utils/registration/point_cloud.hpp"
#include "brew/utils/registration/point_to_plane_icp.hpp"
#include "brew/utils/registration/point_to_point_icp.hpp"
#include "brew/utils/registration/template_library.hpp"
#include "brew/utils/measurement_sampling/measurement_sampling.hpp"
